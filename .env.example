# ============================================
# AI AGENT PERSONAL - Environment Variables
# ============================================
# Copy file ini ke .env lalu isi API key kamu

# ===== PRIMARY LLM: Google Gemini (GRATIS) =====
# Daftar gratis di: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash-exp

# ===== FALLBACK LLM: Groq (GRATIS, super cepat) =====
# Daftar gratis di: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ===== OPTIONAL: HuggingFace (GRATIS, unlimited) =====
# Daftar gratis di: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_hf_token_here

# ===== App Settings =====
APP_LANGUAGE=id
DEFAULT_TIMEZONE=Asia/Jakarta