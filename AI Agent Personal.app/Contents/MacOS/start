#!/bin/bash
# Launcher script untuk AI Agent Personal.app
# Auto-start streamlit + localtunnel

# Get the project root (parent of .app bundle)
APP_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(dirname "$(dirname "$APP_DIR")")"

# Open Terminal so user bisa lihat progress
osascript <<EOF
tell application "Terminal"
    activate
    do script "clear && echo '================================================' && echo '  AI AGENT PERSONAL - STARTING...' && echo '================================================' && echo '' && cd '$PROJECT_DIR' && echo '[1/3] Membersihkan...' && pkill -f 'streamlit run' 2>/dev/null; pkill -f 'localtunnel' 2>/dev/null; sleep 2 && echo '[2/3] Starting Streamlit...' && source venv/bin/activate && nohup streamlit run ui/app.py --server.headless true --server.port 8501 --server.address 0.0.0.0 > /tmp/streamlit.log 2>&1 & sleep 8 && echo '  ✓ Streamlit ready' && echo '' && echo '[3/3] Starting Tunnel...' && echo '' && echo '================================================' && echo '  COPY URL DI BAWAH UNTUK BUKA DI CHROME!' && echo '================================================' && echo '' && npx localtunnel --port 8501"
end tell
EOF